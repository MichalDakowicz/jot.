{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@jot/web"
      ],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "-w",
        "@jot/mobile",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
